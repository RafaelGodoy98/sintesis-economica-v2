config {
  type: "view",
  schema: "marts",
  description: "Estado de actualización por fuente (como verificar.py de V1): informa, no detiene. data_status: ¿llegó el dato que el calendario anunciaba? calendar_status: ¿el calendario cubre el año en curso?",
  columns: {
    as_of_date: "Fecha de referencia: hoy en Santiago, o la variable as_of_date para simular otra fecha.",
    expected_period: "Período que ya debería estar: el de la última publicación con release_date + 1 día <= as_of_date.",
    last_period: "Último período disponible en staging.",
    calendar_until: "Última fecha de publicación que trae el calendario para la fuente.",
    data_status: "OK o ATRASADO.",
    calendar_status: "VIGENTE, VENCIDO (año en curso sin calendario) o NO APLICA (UF, diaria)."
  }
}

-- 1. "Hoy", una sola vez.
WITH today AS (
  SELECT ${dates.asOfDate()} AS as_of_date
),

-- 2. Las fuentes que tienen ficha, con su frecuencia.
sources AS (
  SELECT DISTINCT source_id, frequency
  FROM ${ref("dim_series")}
),

-- 3. Hasta dónde llegan los datos de cada fuente.
last_data AS (
  SELECT source_id, MAX(period) AS last_period
  FROM ${ref("stg_bcentral__observations")}
  GROUP BY source_id
),

-- 4. Qué período debería estar ya (margen: 1 día después de la publicación) y hasta cuándo cubre el calendario.
expected AS (
  SELECT
    c.source_id,
    MAX(IF(DATE_ADD(c.release_date, INTERVAL 1 DAY) <= t.as_of_date, c.reference_period, NULL)) AS expected_period,
    MAX(c.release_date) AS calendar_until
  FROM ${ref("stg_reference__release_calendar")} AS c
  CROSS JOIN today AS t
  GROUP BY c.source_id
)

SELECT
  s.source_id,
  t.as_of_date,
  e.expected_period,
  d.last_period,
  e.calendar_until,
  CASE
    WHEN s.frequency = 'daily' THEN IF(d.last_period >= t.as_of_date, 'OK', 'ATRASADO')  -- UF: cubre hasta hoy
    WHEN d.last_period >= e.expected_period THEN 'OK'
    ELSE 'ATRASADO'
  END AS data_status,
  CASE
    WHEN s.frequency = 'daily' THEN 'NO APLICA'
    WHEN e.calendar_until IS NULL
      OR EXTRACT(YEAR FROM t.as_of_date) > EXTRACT(YEAR FROM e.calendar_until) THEN 'VENCIDO'
    ELSE 'VIGENTE'
  END AS calendar_status
FROM sources AS s
CROSS JOIN today AS t
LEFT JOIN last_data AS d ON d.source_id = s.source_id
LEFT JOIN expected AS e ON e.source_id = s.source_id
