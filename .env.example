# Variables de ejecución de la ingesta (ingest/src/sintesis_ingest/config.py).
# Valores ficticios. En WSL se exportan en tu shell (p. ej. ~/.bashrc), fuera del repo; en la nube las define Terraform.

# Entorno: local | dev | prod
SINTESIS_ENV=local

# Dónde se guarda el raw: local | gcs
SINTESIS_STORAGE_BACKEND=local
SINTESIS_LOCAL_DATA_DIR=data
# Obligatoria si SINTESIS_STORAGE_BACKEND=gcs
SINTESIS_GCS_BUCKET=

# Obligatoria: contacto que va en el User-Agent de cada solicitud
SINTESIS_CONTACT_EMAIL=you@example.com

# Pausa entre solicitudes a una misma fuente (segundos)
SINTESIS_REQUEST_PAUSE_SECONDS=2

# DEBUG | INFO | WARNING | ERROR
SINTESIS_LOG_LEVEL=INFO
SINTESIS_GCP_PROJECT=
